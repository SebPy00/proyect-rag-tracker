# Merge into the EXISTING host Nginx configuration; do not replace other sites.
# Substitute DNS name and existing certificate paths before nginx -t and reload.
server {
    listen 80;
    server_name tracker.datalab.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name tracker.datalab.example;
    ssl_certificate /etc/letsencrypt/live/tracker.datalab.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tracker.datalab.example/privkey.pem;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8095;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 190s;
    }
}
