# Copy to .env.prod (ignored), chmod 600. Never commit real credentials.
DJANGO_SECRET_KEY=
DB_PASS=
DB_NAME=rag_tracker
DB_USER=rag_tracker
# Replace with the actual DataLab DNS name. localhost is used by the backend healthcheck.
ALLOWED_HOSTS=tracker.datalab.example,localhost
CSRF_TRUSTED_ORIGINS=https://tracker.datalab.example
CORS_ALLOWED_ORIGINS=
APP_PORT=8095
AI_ENABLED=false
EMBEDDINGS_ENABLED=false
INSTALL_AI=false
OLLAMA_MODEL=llama3.2:1b
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Initial LAN deployment: HTTPS remains mandatory; enable HSTS only after verification.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
